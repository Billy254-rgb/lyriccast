# Set these in your host's Environment tab (Render: Environment).
# PORT: set automatically by most hosts.
PORT=3000
# DATABASE_URL (recommended on free hosts): a Postgres connection string, for example from a free Neon or Supabase database.
# With it, accounts, songs and schedules survive restarts and redeploys. Without it, data is kept in a file.
DATABASE_URL=
# DATA_DIR: where the file copy is kept when DATABASE_URL is empty. Point it at a persistent disk if you have one.
DATA_DIR=.

{
  "name": "lyriccast",
  "version": "1.0.0",
  "description": "LyricCast lyrics controller for vMix",
  "author": "LyricCast",
  "main": "main.js",
  "private": true,
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "devDependencies": { "electron": "45.2.3", "electron-builder": "26.18.0" },
  "build": {
    "appId": "app.lyriccast.desktop",
    "productName": "LyricCast",
    "files": ["main.js", "www/**/*", "icon.png", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "LyricCast-Setup-${version}.${ext}" },
    "portable": { "artifactName": "LyricCast-Portable-${version}.${ext}" }
  }
}
